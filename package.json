{
  "name": "razai-sistema",
  "productName": "Razai Sistema",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Sistema desktop Razai — Gestão e Engenharia Têxtil",
  "author": "Razai",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:native": "dotnet publish native/windows-share/WindowsShare.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o resources/bin",
    "build": "npm run build:native && electron-vite build",
    "build:win": "npm run build:native && electron-vite build && electron-builder --win",
    "package:win": "npm run build:native && electron-vite build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/unzipper": "^0.10.11",
    "electron": "^36.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "svelte": "^5.33.3",
    "svelte-check": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
